{
  "name": "lol-manager",
  "version": "2.1.1",
  "description": "Alts, a local manager for League of Legends accounts",
  "author": "Alts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lolkeychain.app",
    "productName": "Alts",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico",
      "icon.png",
      "package.json",
      "app.js",
      "styles.css",
      "mini.html",
      "mini.js",
      "fonts/**",
      "tray.png",
      "tray@2x.png",
      "ui.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Alts",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Alts-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Henstli",
        "repo": "lol-keychain",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
